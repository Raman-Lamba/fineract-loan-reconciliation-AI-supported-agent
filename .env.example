# Copy to .env (git-ignored). start.ps1 writes this file for you on first run.
MIFOSX_BASE_URL=http://localhost:4200/fineract-provider/api/v1
MIFOSX_TENANT_ID=default
MIFOSX_USERNAME=mifos
MIFOSX_PASSWORD=
# Layout of your own bank export, data\bank_export.csv (README: "Use your own bank statement"). Only hdfc so far.
BANK=hdfc
# Optional: address of the Mifos web app, for the review page's "Open in Mifos" links, if it is not the host in MIFOSX_BASE_URL.
# MIFOS_URL=http://localhost:4200
