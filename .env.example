# Copy to .env (git-ignored). start.ps1 writes this file for you on first run, and the page's Connect tab
# fills it in from a form, so nobody has to edit it by hand.
MIFOSX_BASE_URL=http://127.0.0.1:4200/fineract-provider/api/v1
MIFOSX_TENANT_ID=default
MIFOSX_USERNAME=mifos
MIFOSX_PASSWORD=
# Whose narrations your bank statement has: hdfc, icici, sbi, or other (names then come only from the AI reader).
BANK=hdfc
# Country and money (Connect tab, "Country and money"). Defaults are India's, so leave them out for India. COUNTRY fills
# the rest as a starting point (unverified for every country but India; see README "Using it outside India").
# COUNTRY=India
# CURRENCY=INR
# PARTNER_SHARE_PERCENT=80
# DATE_ORDER=day-first
# NUMBER_FORMAT=1,234.56
# CHANNELS=UPI,NEFT,IMPS,NACH
# Optional: the AI statement reader (README: "AI statement reader"). Without a key everything works as before.
# Easiest: choose it on the page's Connect tab. By hand: AI_PROVIDER is claude (default), openai, gemini or other;
# each service has its own key line, and a key is only ever sent to its own service.
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Claude only: balanced (default: Opus for layouts and ranking, Sonnet for narrations), best (all Opus) or cheapest (all Haiku).
# AI_QUALITY=balanced
# One model for every task; overrides AI_QUALITY. Leave it out for Claude unless you need a specific model.
# AI_MODEL=claude-opus-5-5
# "other" = any OpenAI-compatible service. A model on this computer (Ollama) needs no key and sends nothing out:
# AI_PROVIDER=other
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_API_KEY=
# Optional: address of the Mifos web app, for the review page's "Open in Mifos" links, if it is not the host in MIFOSX_BASE_URL.
# MIFOS_URL=http://localhost:4200
